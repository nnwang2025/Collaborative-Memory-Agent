# Never send secrets into the Docker build context.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
secrets/
secret/
credentials*
*.kdbx
.npmrc
.pypirc

# Virtual environments and local tool caches.
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local runtime databases, raw exports, live data, and indexes are not source.
data/live/
data/chat_raw.json
*.sqlite3
*.sqlite3-*
*.db
*.faiss
live_index/
db_md/
logs/
*.log

# Local model caches (never bake downloaded weights into the image).
.cache/
models/
model_cache/

# Generated reports and benchmark outputs are local artifacts.
benchmark/reports/
benchmark/v2/reports/
benchmark/dev/reports/
benchmark/v3/reports/
benchmark/v4/reports/
reports/
*.jsonl

# Tests and development-only dependencies are not needed in the runtime image.
tests/
requirements-dev.txt

# VCS, editors, OS metadata, and temporary files.
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db
tmp/
temp/
INTERVIEW_HANDBOOK.md
