# DeepSeek official API (canonical)
# Leave the key empty until you have a real credential.  A template value such
# as "your_api_key_here" is treated as unconfigured at runtime.
# Base URL and model are optional; when empty they default to
# https://api.deepseek.com and deepseek-flash once a DeepSeek key is present.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Legacy compatible providers (optional, uncomment only if needed)
# SILICONFLOW_API_KEY=
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_MODEL=Qwen/Qwen2.5-14B-Instruct

# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# MODEL_NAME=

# Local storage (optional; defaults are relative to the project)
# EVIDENCE_DB_PATH=data/live/evidence.sqlite3
# DECISION_DB_PATH=data/live/decisions.sqlite3
